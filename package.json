{
  "name": "pumice.js",
  "version": "0.0.17",
  "description": "File-system based typed api server framework",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:contract": "UPDATE_CONTRACT_FIXTURES=1 vitest run test/contract.test.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pumicejs/pumice.js.git"
  },
  "bugs": {
    "url": "https://github.com/pumicejs/pumice.js/issues"
  },
  "homepage": "https://github.com/pumicejs/pumice.js#readme",
  "keywords": [
    "pumicejs",
    "pumice.js",
    "typescript",
    "hono",
    "zod",
    "api",
    "server",
    "framework",
    "file-based-routing",
    "schema-validation"
  ],
  "author": "Filip Podstawski <filip@surdic.de>",
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^2.1.5"
  },
  "peerDependencies": {
    "hono": "^4.13.14",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "hono": "^4.13.14",
    "prettier": "^3.9.10",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "zod": "^4.3.6"
  }
}
